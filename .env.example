# ==========================================
# Conecta Voluntários — Variáveis de Ambiente
# ==========================================

# Chave secreta da sessão do Flask (Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=sua_chave_secreta_super_segura_aqui

# Conexão com o PostgreSQL do Supabase (Prefira Session Pooler com SSL na porta 5432)
# Exemplo: postgresql://postgres.[SUA_REF]:[SUA_SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.seuid:suasenha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Ambiente da aplicação (development ou production)
FLASK_ENV=development
PORT=5000

# Credenciais do Administrador Inicial (usadas na inicialização automática ou no deploy)
ADMIN_USER=admin
ADMIN_PASSWORD=admin_senha_forte_aqui
